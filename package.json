{
  "name": "bt-finder",
  "version": "0.1.0",
  "private": true,
  "description": "Web app that finds nearby Bluetooth devices and estimates which way they are.",
  "type": "module",
  "scripts": {
    "start": "node scripts/serve.mjs",
    "test": "node --test",
    "ios:sync": "node scripts/vendor-capacitor.mjs && cap sync ios",
    "ios:open": "cap open ios"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@capacitor-community/bluetooth-le": "8.3.0",
    "@capacitor/core": "8.6.0",
    "@capacitor/ios": "8.6.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0"
  }
}
